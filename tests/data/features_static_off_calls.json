{
 "configs/odisha_v120_3ha_squares_koraput.yaml": {
  "calls": [
   [
    "ee.Image",
    [
     "'NASA/NASADEM_HGT/001'"
    ],
    {}
   ],
   [
    "ee.Image().select",
    [
     "'elevation'"
    ],
    {}
   ],
   [
    "ee.Image().select().toFloat",
    [],
    {}
   ],
   [
    "ee.Image().select().toFloat().rename",
    [
     "'elevation'"
    ],
    {}
   ],
   [
    "ee.Terrain.slope",
    [
     "ee.Image().select().toFloat()"
    ],
    {}
   ],
   [
    "ee.Terrain.slope().rename",
    [
     "'slope'"
    ],
    {}
   ],
   [
    "ee.Terrain.aspect",
    [
     "ee.Image().select().toFloat()"
    ],
    {}
   ],
   [
    "ee.Terrain.aspect().rename",
    [
     "'aspect'"
    ],
    {}
   ],
   [
    "ee.Image",
    [
     "'JRC/GSW1_4/GlobalSurfaceWater'"
    ],
    {}
   ],
   [
    "roi.buffer",
    [
     "14292"
    ],
    {
     "maxError": "1"
    }
   ],
   [
    "ee.Image().select",
    [
     "'occurrence'"
    ],
    {}
   ],
   [
    "ee.Image().select().clip",
    [
     "roi.buffer()"
    ],
    {}
   ],
   [
    "ee.Image().select().clip().gte",
    [
     "50.0"
    ],
    {}
   ],
   [
    "ee.Image().select().clip().gte().unmask",
    [
     "0"
    ],
    {}
   ],
   [
    "ee.Image().select().clip().gte().unmask().fastDistanceTransform",
    [
     "1000",
     "'pixels'",
     "'squared_euclidean'"
    ],
    {}
   ],
   [
    "ee.Image().select().clip().gte().unmask().fastDistanceTransform().sqrt",
    [],
    {}
   ],
   [
    "ee.Image().select().clip().gte().unmask().fastDistanceTransform().sqrt().multiply",
    [
     "10"
    ],
    {}
   ],
   [
    "ee.Image().select().clip().gte().unmask().fastDistanceTransform().sqrt().multiply().rename",
    [
     "'distance_to_water'"
    ],
    {}
   ],
   [
    "ee.ImageCollection",
    [
     "'UCSB-CHG/CHIRPS/PENTAD'"
    ],
    {}
   ],
   [
    "ee.ImageCollection().filterDate",
    [
     "'1991-01-01'",
     "'2020-12-31'"
    ],
    {}
   ],
   [
    "ee.ImageCollection().filterDate().sum",
    [],
    {}
   ],
   [
    "ee.ImageCollection().filterDate().sum().divide",
    [
     "30"
    ],
    {}
   ],
   [
    "ee.ImageCollection().filterDate().sum().divide().rename",
    [
     "'annual_rainfall'"
    ],
    {}
   ],
   [
    "ee.Image.cat",
    [
     [
      "ee.Image().select().toFloat().rename()",
      "ee.Terrain.slope().rename()",
      "ee.Terrain.aspect().rename()",
      "ee.Image().select().clip().gte().unmask().fastDistanceTransform().sqrt().multiply().rename()",
      "ee.ImageCollection().filterDate().sum().divide().rename()"
     ]
    ],
    {}
   ],
   [
    "ee.Image.cat().clip",
    [
     "roi"
    ],
    {}
   ],
   [
    "ee.Image.cat().clip().bandNames",
    [],
    {}
   ]
  ],
  "metadata": {
   "climate_dataset": "UCSB-CHG/CHIRPS/PENTAD",
   "climate_window": "1991-01-01 to 2020-12-31",
   "dem_dataset": "NASA/NASADEM_HGT/001",
   "include_climate": true,
   "max_water_distance_pixels": 1000,
   "output_bands": [
    "elevation",
    "slope",
    "aspect",
    "distance_to_water",
    "annual_rainfall"
   ]
  }
 },
