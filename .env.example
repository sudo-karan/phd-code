# .env.example
# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored and never committed.
#
# When you clone this repo:
#   cp .env.example .env
#   # then edit .env with your actual values

# === GEE settings ===

# Your Google Cloud project ID that has Earth Engine API enabled.
# Find this in the GCP console, or by running `earthengine ls` after authenticating.
GEE_PROJECT_ID=your-gee-project-id-here

# Optional: path where the pipeline writes baked GEE assets.
# Defaults to projects/{GEE_PROJECT_ID}/assets/fmu  if left blank.
GEE_ASSET_ROOT=

# === Local paths ===

# Where the pipeline writes local outputs (GeoTIFFs, reports, run manifests).
# Defaults to ./outputs if left blank.
OUTPUT_DIR=

# === Logging ===

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
