# Environment secrets — NEVER commit these
.env
.env.local
.env.*.local

# GEE auth credentials
.config/earthengine/
credentials

# Python virtual environments
.venv/
venv/
env/
.python-version

# Python build / cache
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Jupyter
.ipynb_checkpoints/
*-checkpoint.ipynb

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Output artifacts (these are produced by the pipeline; not source)
outputs/
*.tif
*.geotiff
*.zip
*.parquet

# Logs
*.log
logs/

# Local notebooks for scratch (notebooks/exploration is allowed; user adds patterns here as needed)
# Uncomment the next line to ignore everything in exploration except a .gitkeep:
# notebooks/exploration/*
# !notebooks/exploration/.gitkeep

# Deck render artifacts (produced from FMU_deck.pptx for QA; not source)
/FMU_deck.pdf
/slide-*.jpg

# Deck build artifacts (honest deck): render previews + report screenshots
/FMU_honest_deck.pdf
/hslide-*.jpg
/report_screenshot_*.png
