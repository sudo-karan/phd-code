# Environment secrets — NEVER commit these
.env
.env.local
.env.*.local

# GEE auth credentials
.config/earthengine/
credentials

# Python virtual environments
.venv/
venv/
env/
.python-version

# Python build / cache
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Jupyter
.ipynb_checkpoints/
*-checkpoint.ipynb

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Output artifacts (these are produced by the pipeline; not source)
outputs/
*.tif
*.tiff
*.geotiff
*.zip
*.parquet

# Run artifacts, exported vectors and report figures. All regenerable from a
# live run; none of it is source. These were tracked until v1.2.1 and the
# numbers in them predate the merge stage, so leaving them committed presented
# superseded results as if current. Recover any of it from history with
#   git checkout b24fad3 -- runs/ fmu_exports_clean/ reports/
runs/
fmu_exports_clean/
reports/

# Phase 2 statistics checkpoints. odisha_phase2_5_stats.py writes one file per
# arm x layer beside its outputs so an interrupted run resumes. Keyed by a digest
# of the inputs, but committing them would let a checkpoint from an older run
# supply a partition's numbers on a rerun instead of recomputing it. The results
# files are the record; these are only a resume cache.
odisha_script/phase2_5_checkpoints/

# Slide decks. Built by scripts/build_*.js, which stay in the repo; the .pptx
# output does not. Binary, large, and stale the moment the design moves on.
*.pptx

# Logs
*.log
logs/

# Local notebooks for scratch (notebooks/exploration is allowed; user adds patterns here as needed)
# Uncomment the next line to ignore everything in exploration except a .gitkeep:
# notebooks/exploration/*
# !notebooks/exploration/.gitkeep

# Deck render artifacts (produced from FMU_deck.pptx for QA; not source)
/FMU_deck.pdf
/slide-*.jpg

# Deck build artifacts (honest deck): render previews + report screenshots
/FMU_honest_deck.pdf
/hslide-*.jpg
/report_screenshot_*.png

# Master deck render artifacts
/FMU_master_deck.pdf
/FMU_honest_deck.pdf
/mslide-*.jpg
/hslide-*.jpg
/report_screenshot_*.png
